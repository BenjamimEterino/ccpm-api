generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id_user      String         @id @default(uuid())
  email        String         @unique
  senha        String         @db.LongText
  nome         String?
  role         roles?
  contacto     String?
  formacao     String?
  project      project[]
  notification notification[]
  requisicao   requisicao[]
}

enum roles {
  admin
  encarregado
  directorObra
  directorProjecto
  gestorLogistica
}

model project {
  id_project  String        @id @default(uuid())
  nome        String
  local       String?
  orcamento   Float?
  data_inicio DateTime?
  data_fim    DateTime?
  user_id     String?
  user        user?         @relation(fields: [user_id], references: [id_user])
  requisicao  requisicao[]
  funcionario funcionario[]
  client      cliente?      @relation(fields: [client_id], references: [id_cliente])
  client_id   String?
  tarefas     tarefa[]

  responsavelProjectos responsavel_projecto?
}

model categoria_func {
  id_categoria_func String        @id @default(uuid())
  descricao         String
  funcionario       funcionario[]
}

model funcionario {
  id_funcionario       String                 @id @default(uuid())
  nome                 String
  morada               String?
  contacto             String?
  categ_id             String
  categoria            categoria_func         @relation(fields: [categ_id], references: [id_categoria_func])
  project              project[]
  responsavelProjectos responsavel_projecto[]

  tarefas tarefa[]
}

model notification {
  id_notification String   @id @default(uuid())
  mensagem        String   @db.MediumText
  lida            Boolean  @default(false)
  data            DateTime @default(now())
  user_id         String
  user            user     @relation(fields: [user_id], references: [id_user])
}

model categoria_prod {
  id_categoria_prod String    @id @default(uuid())
  descricao         String
  product           produto[]
}

model produto {
  id_produto         String               @id @default(uuid())
  nome               String
  marca              String?
  preco              Float?
  categoria_id       String
  category           categoria_prod       @relation(fields: [categoria_id], references: [id_categoria_prod])
  requisicao         requisicao[]
  requisicao_produto requisicao_produto[]
}

model requisicao {
  id_requisicao      String               @id @default(uuid())
  referencia         Int                  
  data               DateTime             @default(now())
  descricao          String?              @db.MediumText
  status             status               @default(pendente)
  project_id         String
  user_id            String
  project            project              @relation(fields: [project_id], references: [id_project])
  user               user                 @relation(fields: [user_id], references: [id_user])
  produto            produto[]
  requisicao_produto requisicao_produto[]
  id_tarefa          String?
  tarefa             tarefa?              @relation(fields: [id_tarefa], references: [id_tarefa])
}

model requisicao_produto {
  quantidade    Int
  product_id    String
  requisicao_id String
  product       produto    @relation(fields: [product_id], references: [id_produto])
  requisicao    requisicao @relation(fields: [requisicao_id], references: [id_requisicao])

  @@id([product_id, requisicao_id])
}

model cliente {
  id_cliente String    @id @default(uuid())
  nome       String
  email      String    @unique
  contacto   String?
  projects   project[]
}

model tarefa {
  id_tarefa      String        @id @default(uuid())
  descricao      String?       @db.MediumText
  actividade     String
  data_inicio    DateTime?
  data_fim       DateTime?
  status         status_tarefa @default(nova)
  project_id     String
  project        project       @relation(fields: [project_id], references: [id_project])
  responsavel_id String?
  responsavel    funcionario?  @relation(fields: [responsavel_id], references: [id_funcionario])

  requisicaos requisicao[]
}

model responsavel_projecto {
  project_id     String      @unique
  funcionario_id String
  project        project     @relation(fields: [project_id], references: [id_project])
  funcionario    funcionario @relation(fields: [funcionario_id], references: [id_funcionario])

  @@id([project_id, funcionario_id])
}

enum status {
  pendente
  aceite
  entregue
  rejeitado
}

enum status_tarefa {
  nova
  atribuida
  em_progresso
  concluida
}
